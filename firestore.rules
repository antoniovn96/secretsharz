rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function hasClaimRole(role) { return isSignedIn() && request.auth.token.role == role; }
    function isFounderAdmin() { return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email == 'antonio.antonio.noronha@gmail.com'; }
    function profileRole(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.role; }
    function isAdmin() { return isFounderAdmin() || hasClaimRole('super_admin') || (isSignedIn() && profileRole(request.auth.uid) == 'super_admin'); }
    function isParent() { return isSignedIn() && (hasClaimRole('parent') || profileRole(request.auth.uid) == 'parent'); }
    function isStaff() { return isSignedIn() && (request.auth.token.role in ['counsellor','career_counsellor','psychologist','educator'] || profileRole(request.auth.uid) in ['counsellor','career_counsellor','psychologist','educator']); }

    // Cross-user professional/guardian authorization is now server/API-only.
    // Firestore rules must not continue treating assignedStaff.* or parent.userId
    // as authoritative relationship data. Those fields remain compatibility data
    // during migration and are never sufficient for direct client access.

    function validMobile(number) {
      return number == '' || number.matches('^[6-9][0-9]{9}$');
    }

    function validUserPhoneData() {
      return (!request.resource.data.keys().hasAny(['phone'])
        || !request.resource.data.phone.keys().hasAny(['number'])
        || validMobile(request.resource.data.phone.number))
        && (!request.resource.data.keys().hasAny(['careerProfile'])
        || !request.resource.data.careerProfile.keys().hasAny(['phone'])
        || !request.resource.data.careerProfile.phone.keys().hasAny(['number'])
        || validMobile(request.resource.data.careerProfile.phone.number));
    }

    function hasAccountConsent(uid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/consentEvents/$('account_' + uid))
        && get(/databases/$(database)/documents/consentEvents/$('account_' + uid)).data.userId == uid
        && get(/databases/$(database)/documents/consentEvents/$('account_' + uid)).data.type == 'account_privacy'
        && get(/databases/$(database)/documents/consentEvents/$('account_' + uid)).data.action == 'granted'
        && get(/databases/$(database)/documents/consentEvents/$('account_' + uid)).data.policyVersion == '1.0.0'
        && get(/databases/$(database)/documents/consentEvents/$('account_' + uid)).data.keys().hasAll(['userId','type','action','actorType','relationshipId','serviceContext','policyVersion','createdAt']);
    }

    function validConsentEventCreate() {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['account_privacy','counselling','sen','career_guidance','community','ai_feature']
        && request.resource.data.action in ['granted','withdrawn','updated']
        && request.resource.data.actorType == 'self'
        && request.resource.data.policyVersion == '1.0.0'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['userId','type','action','actorType','relationshipId','serviceContext','policyVersion','createdAt']);
    }

    match /consentEvents/{eventId} {
      allow create: if validConsentEventCreate()
        && (request.resource.data.type == 'account_privacy') == (eventId == 'account_' + request.auth.uid);
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    // Student documents contain sensitive cross-service information. Direct
    // client access is limited to the student themselves or an administrator.
    // Parents, institutions and professionals must use their authorization-aware
    // projection APIs, which evaluate canonical relationships, service, purpose,
    // consent and release rules server-side.
    match /students/{studentId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == studentId);
      allow write: if isAdmin();

      // Legacy subcollections remain readable only by the student/admin while
      // their APIs are migrated. Professional cross-user access is API-only.
      match /career_roadmaps/{roadmapId} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.uid == studentId);
        allow create, update, delete: if isAdmin();
      }

      match /career_notes/{noteId} {
        allow read: if isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    match /caseFiles/{fileId} {
      // Case-file access is also projection/API controlled. Do not authorize
      // cross-user reads from the legacy staffId field.
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.studentId && resource.data.isPrivate == false);
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin()
        || (isSignedIn()
          && request.auth.uid == userId
          && hasAccountConsent(userId)
          && request.resource.data.role == 'student'
          && validUserPhoneData()
          && !request.resource.data.keys().hasAny(['admin','permissions','careerReportAccess']));
      allow update: if isAdmin()
        || (isSignedIn()
          && request.auth.uid == userId
          && validUserPhoneData()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','admin','permissions','careerReportAccess']));
      allow delete: if isAdmin();
    }

    match /counselling/{document=**} { allow read, write: if false; }
    match /sen/{document=**} { allow read, write: if false; }
    match /career/{document=**} { allow read, write: if false; }
    match /safeguarding/{document=**} { allow read, write: if false; }
    match /auditEvents/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
