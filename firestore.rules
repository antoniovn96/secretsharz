rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function hasClaimRole(role) { return isSignedIn() && request.auth.token.role == role; }
    function isFounderAdmin() { return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email == 'antonio.antonio.noronha@gmail.com'; }
    // Custom claims are the primary runtime authority.
    // users/{uid}.role remains a migration-only fallback for legacy accounts.
    function profileRole(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.role; }
    function isAdmin() { return isFounderAdmin() || hasClaimRole('super_admin') || (isSignedIn() && profileRole(request.auth.uid) == 'super_admin'); }
    function isParent() { return isSignedIn() && (hasClaimRole('parent') || profileRole(request.auth.uid) == 'parent'); }
    function isStaff() { return isSignedIn() && (request.auth.token.role in ['counsellor','career_counsellor','psychologist','educator'] || profileRole(request.auth.uid) in ['counsellor','career_counsellor','psychologist','educator']); }
    function isAssignedStaffForStudent(studentId) {
      return isStaff()
        && get(/databases/$(database)/documents/students/$(studentId)).data.assignedStaff.careerId == request.auth.uid;
    }

    function hasAccountConsent(uid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/consentEvents/$('account_' + uid))
        && get(/databases/$(database)/documents/consentEvents/$('account_' + uid)).data.userId == uid
        && get(/databases/$(database)/documents/consentEvents/$('account_' + uid)).data.type == 'account_privacy'
        && get(/databases/$(database)/documents/consentEvents/$('account_' + uid)).data.action == 'granted'
        && get(/databases/$(database)/documents/consentEvents/$('account_' + uid)).data.policyVersion == '1.0.0'
        && get(/databases/$(database)/documents/consentEvents/$('account_' + uid)).data.keys().hasAll(['userId','type','action','actorType','relationshipId','serviceContext','policyVersion','createdAt']);
    }

    function validConsentEventCreate() {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['account_privacy','counselling','sen','career_guidance','community','ai_feature']
        && request.resource.data.action in ['granted','withdrawn','updated']
        && request.resource.data.actorType == 'self'
        && request.resource.data.policyVersion == '1.0.0'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['userId','type','action','actorType','relationshipId','serviceContext','policyVersion','createdAt']);
    }

    match /consentEvents/{eventId} {
      allow create: if validConsentEventCreate()
        && (request.resource.data.type == 'account_privacy') == (eventId == 'account_' + request.auth.uid);
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    match /students/{studentId} {
      allow read: if isSignedIn() && (
        request.auth.uid == studentId ||
        (isParent() && resource.data.parent.userId == request.auth.uid) ||
        (isStaff() && (resource.data.assignedStaff.careerId == request.auth.uid || resource.data.assignedStaff.psychId == request.auth.uid || resource.data.assignedStaff.senId == request.auth.uid)) ||
        isAdmin()
      );
      allow write: if isAdmin();

      match /career_roadmaps/{roadmapId} {
        allow read: if isAdmin() || isAssignedStaffForStudent(studentId) || (isSignedIn() && request.auth.uid == studentId);
        allow create: if isAdmin() || (isAssignedStaffForStudent(studentId) && request.resource.data.providerId == request.auth.uid);
        allow update: if isAdmin() || (isAssignedStaffForStudent(studentId) && resource.data.providerId == request.auth.uid && request.resource.data.providerId == request.auth.uid);
        allow delete: if isAdmin() || (isAssignedStaffForStudent(studentId) && resource.data.providerId == request.auth.uid);
      }

      match /career_notes/{noteId} {
        allow read: if isAdmin() || isAssignedStaffForStudent(studentId);
        allow create: if isAdmin() || (isAssignedStaffForStudent(studentId) && request.resource.data.providerId == request.auth.uid);
        allow update: if isAdmin() || (isAssignedStaffForStudent(studentId) && resource.data.providerId == request.auth.uid && request.resource.data.providerId == request.auth.uid);
        allow delete: if isAdmin() || (isAssignedStaffForStudent(studentId) && resource.data.providerId == request.auth.uid);
      }
    }

    match /caseFiles/{fileId} {
      allow read: if isAdmin() || (isStaff() && resource.data.staffId == request.auth.uid) || (isSignedIn() && request.auth.uid == resource.data.studentId && resource.data.isPrivate == false);
      allow create: if isAdmin() || (isStaff() && request.resource.data.staffId == request.auth.uid);
      allow update: if isAdmin() || (isStaff() && resource.data.staffId == request.auth.uid && request.resource.data.staffId == resource.data.staffId && request.resource.data.studentId == resource.data.studentId && request.resource.data.isPrivate == resource.data.isPrivate);
      allow delete: if isAdmin() || (isStaff() && resource.data.staffId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin()
        || (isSignedIn()
          && request.auth.uid == userId
          && hasAccountConsent(userId)
          && request.resource.data.role == 'student'
          && !request.resource.data.keys().hasAny(['admin','permissions']));
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','admin','permissions']));
      allow delete: if isAdmin();
    }

    match /counselling/{document=**} { allow read, write: if false; }
    match /sen/{document=**} { allow read, write: if false; }
    match /career/{document=**} { allow read, write: if false; }
    match /safeguarding/{document=**} { allow read, write: if false; }
    match /auditEvents/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
