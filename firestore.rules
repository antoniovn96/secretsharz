rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAdmin() { return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'; }
    function isParent() { return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent'; }
    function isStaff() { return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['counsellor', 'psychologist', 'educator']; }

    // Master Record Access
    match /students/{studentId} {
      allow read: if request.auth != null && (
        request.auth.uid == studentId || 
        (isParent() && resource.data.parent.userId == request.auth.uid) ||
        (isStaff() && (resource.data.assignedStaff.careerId == request.auth.uid || resource.data.assignedStaff.psychId == request.auth.uid || resource.data.assignedStaff.senId == request.auth.uid)) ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // Case Files & Session Notes
    match /caseFiles/{fileId} {
      allow read: if isAdmin() || 
                     (isStaff() && resource.data.staffId == request.auth.uid) || 
                     (request.auth.uid == resource.data.studentId && resource.data.isPrivate == false);
      allow write: if isAdmin() || (isStaff() && resource.data.staffId == request.auth.uid);
    }
  }
}