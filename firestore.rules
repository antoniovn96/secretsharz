rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // SECURITY FOUNDATION
    // The founder account is recognised only when Firebase Auth confirms the
    // verified email. This is a bootstrap safeguard while the platform moves
    // to server-managed custom claims for long-term role authority.
    function isFounderAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'antonio.antonio.noronha@gmail.com';
    }

    function isAdmin() {
      return isFounderAdmin()
        || (request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
    }

    function isParent() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent';
    }

    function isStaff() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['counsellor', 'psychologist', 'educator'];
    }

    // Master Record Access
    match /students/{studentId} {
      allow read: if request.auth != null && (
        request.auth.uid == studentId ||
        (isParent() && resource.data.parent.userId == request.auth.uid) ||
        (isStaff() && (
          resource.data.assignedStaff.careerId == request.auth.uid ||
          resource.data.assignedStaff.psychId == request.auth.uid ||
          resource.data.assignedStaff.senId == request.auth.uid
        )) ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // Case Files & Session Notes
    match /caseFiles/{fileId} {
      allow read: if isAdmin()
        || (isStaff() && resource.data.staffId == request.auth.uid)
        || (request.auth.uid == resource.data.studentId && resource.data.isPrivate == false);
      allow write: if isAdmin() || (isStaff() && resource.data.staffId == request.auth.uid);
    }

    // User profiles.
    // A self-created profile may only be a student profile. Parent/staff/admin
    // accounts must be provisioned by trusted administrative tooling.
    // Existing users may update their own non-privileged profile fields, but
    // role/admin/permissions remain protected fields.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      allow create: if isAdmin()
        || (request.auth != null
          && request.auth.uid == userId
          && request.resource.data.role == 'student'
          && !request.resource.data.keys().hasAny(['admin', 'permissions']));

      allow update: if isAdmin()
        || (request.auth != null
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin', 'permissions']));

      allow delete: if isAdmin();
    }

    // Default deny: every collection not explicitly declared above remains protected.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
