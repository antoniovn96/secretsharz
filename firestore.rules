rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // SECURITY FOUNDATION
    // Client navigation is never an authorization boundary.
    // Long-term privileged access is issued through trusted Firebase Admin tooling
    // and Firebase Auth custom claims. The Firestore user-document role remains a
    // transitional compatibility path until claims are fully deployed.

    function isSignedIn() {
      return request.auth != null;
    }

    function hasClaimRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isFounderAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'antonio.antonio.noronha@gmail.com';
    }

    function isAdmin() {
      return isFounderAdmin()
        || hasClaimRole('super_admin')
        || (isSignedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
    }

    function isParent() {
      return isSignedIn()
        && (hasClaimRole('parent')
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent');
    }

    function isStaff() {
      return isSignedIn() && (
        request.auth.token.role in ['counsellor', 'psychologist', 'educator']
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['counsellor', 'psychologist', 'educator']
      );
    }

    function validConsentEventCreate() {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in [
          'account_privacy',
          'counselling',
          'sen',
          'career_guidance',
          'community',
          'ai_feature'
        ]
        && request.resource.data.action in ['granted', 'withdrawn', 'updated']
        && request.resource.data.actorType == 'self'
        && request.resource.data.policyVersion == '1.0.0'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'userId',
          'type',
          'action',
          'actorType',
          'relationshipId',
          'serviceContext',
          'policyVersion',
          'createdAt'
        ]);
    }

    // Consent is an append-only event stream. Clients may create their own
    // self-consent events, but may never rewrite or delete historical consent.
    // Guardian/professional/admin consent will be added through trusted workflows.
    match /consentEvents/{eventId} {
      allow create: if validConsentEventCreate();
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    // Master Record Access — LEGACY COMPATIBILITY LAYER.
    // New sensitive domains must not be added to this document. Sensitive data
    // should live in separate protected collections so Firestore rules can grant
    // different access to different domains.
    match /students/{studentId} {
      allow read: if isSignedIn() && (
        request.auth.uid == studentId ||
        (isParent() && resource.data.parent.userId == request.auth.uid) ||
        (isStaff() && (
          resource.data.assignedStaff.careerId == request.auth.uid ||
          resource.data.assignedStaff.psychId == request.auth.uid ||
          resource.data.assignedStaff.senId == request.auth.uid
        )) ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // Case Files & Session Notes — LEGACY COMPATIBILITY LAYER.
    match /caseFiles/{fileId} {
      allow read: if isAdmin()
        || (isStaff() && resource.data.staffId == request.auth.uid)
        || (isSignedIn() && request.auth.uid == resource.data.studentId && resource.data.isPrivate == false);

      allow create: if isAdmin()
        || (isStaff() && request.resource.data.staffId == request.auth.uid);

      allow update: if isAdmin()
        || (isStaff()
          && resource.data.staffId == request.auth.uid
          && request.resource.data.staffId == resource.data.staffId
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.isPrivate == resource.data.isPrivate);

      allow delete: if isAdmin()
        || (isStaff() && resource.data.staffId == request.auth.uid);
    }

    // User profiles.
    // A self-created profile may only be a student profile. Parent/staff/admin
    // accounts must be provisioned by trusted administrative tooling.
    // Existing users may update their own non-privileged profile fields, but
    // role/admin/permissions remain protected fields.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isAdmin()
        || (isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.role == 'student'
          && !request.resource.data.keys().hasAny(['admin', 'permissions']));

      allow update: if isAdmin()
        || (isSignedIn()
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin', 'permissions']));

      allow delete: if isAdmin();
    }

    // Explicit protected-domain placeholders. These remain denied until each
    // domain has its own reviewed schema and relationship-aware rules.
    match /counselling/{document=**} {
      allow read, write: if false;
    }
    match /sen/{document=**} {
      allow read, write: if false;
    }
    match /career/{document=**} {
      allow read, write: if false;
    }
    match /safeguarding/{document=**} {
      allow read, write: if false;
    }
    match /auditEvents/{document=**} {
      allow read, write: if false;
    }

    // Default deny: every collection not explicitly declared above remains protected.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
