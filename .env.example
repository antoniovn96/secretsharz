NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# Optional production abuse-protection layer.
# Configure this only after registering the web app with Firebase App Check
# and reCAPTCHA Enterprise, then enable enforcement after monitoring traffic.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=your_recaptcha_enterprise_site_key_here

# Server-only YouTube Data API v3 key. NEVER prefix this with NEXT_PUBLIC_.
# The key is used by pages/api/youtube-videos.js to read the official Secret
# Sharz channel uploads playlist and must not be exposed to browser JavaScript.
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# ── Firebase Admin SDK (server-only) ───────────────────────────────────────
# Used ONLY by pages/api/admin/assign-role.js to assign/remove Firebase Auth
# custom claims. NEVER prefix these with NEXT_PUBLIC_ and NEVER commit the
# service-account JSON itself. Provide the credential via ONE of:
#   1) FIREBASE_SERVICE_ACCOUNT  = full service-account JSON string, OR
#   2) GOOGLE_APPLICATION_CREDENTIALS = path to a service-account JSON file, OR
#   3) ambient Application Default Credentials (e.g. Vercel/Cloud Run).
# In CI, the Firestore security-rule tests and the server authorization unit
# tests require NONE of these (they use the emulator / pure logic).
# FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=
